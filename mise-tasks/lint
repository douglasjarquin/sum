#!/usr/bin/env bash
#MISE description="Check standalone portable-tool Go tests"
set -euo pipefail
cd "$(dirname "$0")/../tests/portable"
export PATH="$(dirname "$(mise which go)"):${PATH:-}"
unset GOROOT
unformatted="$(gofmt -l .)"
if [ -n "$unformatted" ]; then
  echo "$unformatted"
  exit 1
fi
go vet ./...
