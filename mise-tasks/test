#!/usr/bin/env bash
#MISE description="Run offline Go tests (no credentials or LLM calls)"
set -euo pipefail
cd "$(dirname "$0")/.."
export PATH="$(dirname "$(mise which go)"):${PATH:-}"
unset GOROOT
mkdir -p .local/bin
(cd go && go build -trimpath -buildvcs=false -o ../.local/bin/sumctl ./cmd/sumctl && go test ./...)
