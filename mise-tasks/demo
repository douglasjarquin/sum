#!/usr/bin/env bash
#MISE description="Exercise delegation, a question, an answer, a result, and records backup using a fake Herdr and real Git"
set -euo pipefail
cd "$(dirname "$0")/.."
export PATH="$(dirname "$(mise which go)"):${PATH:-}"
unset GOROOT
mkdir -p .local/bin
(cd go && go build -trimpath -buildvcs=false -o ../.local/bin/sumctl ./cmd/sumctl && go test ./internal/cli -run TestOfflineDemo -count=1 -timeout 15m)
