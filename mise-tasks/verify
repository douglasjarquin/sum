#!/usr/bin/env bash
#MISE description="Canonical aggregate verification: Go CLI, Mesh, skill tests, offline demo, and the web site (see VERIFY.md)"
set -euo pipefail
cd "$(dirname "$0")/.."
export PATH="$(dirname "$(mise which go)"):$(dirname "$(mise which python)"):${PATH:-}"
unset GOROOT
mkdir -p .local/bin
(cd go && go build -trimpath -buildvcs=false -o ../.local/bin/sumctl ./cmd/sumctl && go test ./...)
aube -C web install
aube -C web run check
aube -C web run test:unit
aube -C web run build
