#!/usr/bin/env bash
#MISE description="Verify instruction packaging, portable tools, Bot contracts, and website"
set -euo pipefail
cd "$(dirname "$0")/.."
export PATH="$(dirname "$(mise which go)"):$(dirname "$(mise which python)"):${PATH:-}"
unset GOROOT
(cd tools/verify && go test ./...)
# -count=1: these tests drive the binary built from tools/verify, which the Go test cache does not track.
(cd tests/portable && python3 ../../scripts/fixture_git_env.py -- go test -count=1 ./...)
python3 scripts/fixture_git_env.py -- python3 -m unittest discover -s tests -p 'test_*.py'
aube -C web install --frozen-lockfile
aube -C web run check
aube -C web run test:unit
aube -C web run build
for page in index 404 docs/index install/index architecture/index verification/index skills/index configuration/index herdr/index update/index; do
  test -f "web/dist/$page.html" || { echo "verify: missing web/dist/$page.html" >&2; exit 1; }
done
