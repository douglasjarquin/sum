#!/usr/bin/env bash
# Stable MCP entrypoint. The runtime is resolved once at start; the server then stays pinned to that tree.
set -euo pipefail
ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
RUNTIME="$ROOT"
if [[ -L "$ROOT/.local/current" ]]; then
  RUNTIME=$(cd -- "$ROOT/.local/current" 2>/dev/null && pwd -P) || { echo "herdr-mesh: $ROOT/.local/current points to a missing runtime" >&2; exit 1; }
fi
BINARY="$RUNTIME/.local/bin/herdr-mesh"
if [[ ! -x "$BINARY" ]]; then
  echo "herdr-mesh: staged native binary is missing; run mise run setup or stage a release." >&2
  exit 1
fi
export SUM_INSTALL_ROOT="${SUM_INSTALL_ROOT:-$ROOT}"
export SUM_HERDR_BIN="${SUM_HERDR_BIN:-$RUNTIME/.local/bin/herdr}"
exec "$BINARY" "$@"
