#!/usr/bin/env bash
# Pinned bridge for a running Mesh: uses the code of the tree it sits in, never a moving pointer.
set -euo pipefail
ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
BINARY="$ROOT/.local/bin/sumctl"
if [[ ! -x "$BINARY" ]]; then
  echo "herdr-scoped: staged native binary is missing; run mise run setup or stage a release." >&2
  exit 1
fi
export SUM_INSTALL_ROOT="${SUM_INSTALL_ROOT:-$ROOT}"
exec "$BINARY" herdr -- "$@"
