topic: reviewer-launch
help: "Create a `reviewer` tab in one task workspace and start its independent reviewer under the stable name `reviewer-TASK_ID`; a refused start names the Herdr error code and leaves the task's reviewer state unchanged. Claude reviewers use an explicit empty MCP configuration, so project and user MCP servers are not loaded or approved; a startup block is reported as needs-attention with its reason. Record the live reviewer endpoint and prompt it once; with a live recorded reviewer pane, prompt that pane for the current candidate instead of opening a second tab; with a recorded reviewer proven gone, open a fresh tab, record the rebind, and prompt it"
arguments[6]:
  - name: task
    help: Task ID whose workspace and checkout the reviewer will use
    required: true
  - name: "--harness"
    help: Herdr integration kind for a new reviewer; overrides the saved `reviewer.preset`
    required: false
  - name: "--model"
    help: Model for a new reviewer; overrides the saved preset's model
    required: false
  - name: "--reasoning"
    help: Reasoning effort for a new reviewer; overrides the saved preset's reasoning
    required: false
  - name: "--preset"
    help: Saved preset for a new reviewer instead of `reviewer.preset`
    required: false
  - name: "--permission-override"
    help: "Explicit user authorization for a permission/trust flag carried by the preset; without it such a flag is refused, with it the override is recorded on the reviewer endpoint with its source as requested, never runtime-verified"
subcommands: null
read_only: false
read_only_subcommands: []
