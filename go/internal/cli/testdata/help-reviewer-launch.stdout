topic: reviewer-launch
help: "Launch an independent reviewer at the task Git checkout through HC with a unique bounded native name; record terminal creation, candidate and opening-message effects separately; never accept a trust dialog or replay an uncertain kickoff"
arguments[6]:
  - name: task
    help: Task ID whose verified Git checkout the reviewer uses
    required: true
  - name: "--harness"
    help: harness kind for a new reviewer; overrides the saved `reviewer.preset`
    required: false
  - name: "--model"
    help: Model for a new reviewer; overrides the saved preset's model
    required: false
  - name: "--reasoning"
    help: Reasoning effort for a new reviewer; overrides the saved preset's reasoning
    required: false
  - name: "--preset"
    help: Saved preset for a new reviewer instead of `reviewer.preset`
    required: false
  - name: "--permission-override"
    help: "Explicit user authorization for a permission/trust flag carried by the preset; without it such a flag is refused, with it the override is recorded on the reviewer endpoint with its source as requested, never runtime-verified"
subcommands: null
read_only: false
read_only_subcommands: []
