harness: claude
format: json
target: .mcp.json in the checkout (project scope)
snippet: "{\n  \"mcpServers\": {\n    \"codegraph\": {\n      \"type\": \"stdio\",\n      \"command\": \"$CODEGRAPH\",\n      \"args\": [\n        \"serve\",\n        \"--mcp\"\n      ]\n    }\n  }\n}"
tool:
  pinned: 1.5.0
  path: $CODEGRAPH
  available: true
  version: 1.5.0
  reason: null
note: "Printed only; sum wrote no file, changed no permission list, and did not run `codegraph install`. The server this starts watches only the project it is started in; it is that harness session's process, and cleanup reports it as an occupant of the checkout until the session exits."
