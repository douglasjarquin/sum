snippet: "{\n  \"mcp\": {\n    \"codegraph\": {\n      \"type\": \"local\",\n      \"command\": [\n        \"$CODEGRAPH\",\n        \"serve\",\n        \"--mcp\"\n      ],\n      \"enabled\": true\n    }\n  }\n}"
