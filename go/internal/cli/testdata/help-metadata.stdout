topic: metadata
help: "Optional display-only owned HC labels on verified recorded terminals; never role, lifecycle or approval authority"
arguments: []
subcommands:
  enable: Validate HC capabilities and project owned labels to verified recorded terminals
  disable: "Coordinator only: clear exactly the recorded owned keys per endpoint (failed clears stay diagnostic) and stop projecting"
  status: Saved label projection health and diagnostics; no mutation
  sync: Project one bounded pass of owned label differences to verified endpoints
  snippet: Print optional visibility guidance without modifying configuration
  inbox: Print saved bounded compact/grouped task overview; no legacy plugin-pane API
read_only: false
read_only_subcommands[3]: inbox,snippet,status
