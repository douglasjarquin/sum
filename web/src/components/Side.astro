---
import { sitePath } from "../lib/site-path.mjs";
import { repoBlob } from "../lib/links.mjs";

interface Props {
  active: string;
}
const { active } = Astro.props;

const internal = (key: string, label: string) => ({ key, label, href: sitePath(key) });
const groups = [
  {
    label: "sum",
    items: [
      internal("docs", "Documentation"),
      internal("install", "Install"),
      internal("architecture", "Architecture"),
      internal("verification", "Verification"),
      internal("skills", "Skills"),
      internal("configuration", "Configuration"),
      internal("herdr", "Herdr backend"),
      internal("update", "Update & rollback"),
    ],
  },
  {
    label: "remainder",
    items: [
      internal("remainder", "Overview"),
      internal("remainder-cli", "Providers & CLI contract"),
    ],
  },
  {
    label: "source",
    items: [
      {
        key: "agents-md",
        label: "AGENTS.md ↗",
        href: repoBlob("AGENTS.md"),
      },
      {
        key: "coordinator-md",
        label: "COORDINATOR.md ↗",
        href: repoBlob("COORDINATOR.md"),
      },
      {
        key: "verify-md",
        label: "VERIFY.md ↗",
        href: repoBlob("VERIFY.md"),
      },
    ],
  },
];
---

<nav class="side" aria-label="Documentation">
  {
    groups.map((group) => (
      <>
        <div class="lbl">{group.label}</div>
        {group.items.map((item) => (
          <a
            href={item.href}
            class={item.key === active ? "active" : undefined}
            aria-current={item.key === active ? "page" : undefined}
          >
            {item.label}
          </a>
        ))}
      </>
    ))
  }
</nav>
