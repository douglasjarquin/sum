---
import DocsLayout from "../../layouts/DocsLayout.astro";
import { sitePath } from "../../lib/site-path.mjs";
import { repoBlob } from "../../lib/links.mjs";
---

<DocsLayout title="Documentation — sum">
  <h1>Documentation</h1>
  <p class="lede" style="max-width:640px;margin:0 0 32px">
    Start in your existing HC-backed Herdr terminal. Read the shared entry contract and the Work, Review, Finish, or Resume procedure for the current action.
  </p>
  <div class="cells index-cards">
    <a href={sitePath("install")}>
      <div class="t">Start</div>
      <div class="d">
        Native prerequisites, usual agent launch, qualification limits, and first task.
      </div>
    </a>
    <a href={sitePath("architecture")}>
      <div class="t">Architecture</div>
      <div class="d">
        Lead and bounded helper roles, small task notes, and native communication.
      </div>
    </a>
    <a href={sitePath("verification")}>
      <div class="t">Verification</div>
      <div class="d">
        Stable candidates, required project checks, review, and native acceptance.
      </div>
    </a>
    <a href={sitePath("skills")}>
      <div class="t">Skills</div>
      <div class="d">
        The four procedures: Work, Review, Finish, and Resume.
      </div>
    </a>
    <a href={sitePath("configuration")}>
      <div class="t">Configuration</div>
      <div class="d">Chosen agent settings, permissions, and working conventions.</div>
    </a>
    <a href={sitePath("herdr")}>
      <div class="t">HC terminal runtime</div>
      <div class="d">
        Actual lead identity, parentage, explicit reports, and native waiting.
      </div>
    </a>
    <a href={sitePath("update")}>
      <div class="t">Adoption &amp; updates</div>
      <div class="d">Independent adoption, between-session Git updates, and legacy boundaries.</div>
    </a>
  </div>
  <div
    class="kv"
    style="grid-template-columns:auto 1fr;column-gap:16px;font-size:12px;margin-top:32px"
  >
    <a href={repoBlob("docs/native-hc.md")} style="padding:8px 0">
      docs/native-hc.md ↗
    </a>
    <div class="v" style="padding:8px 0">native prerequisites and qualification limits</div>
    <a href={repoBlob("docs/ACCEPTANCE.md")} style="padding:8px 0">
      docs/ACCEPTANCE.md ↗
    </a>
    <div class="v" style="padding:8px 0">
      authenticated native scenarios and evidence requirements
    </div>
    <a href={repoBlob("docs/legacy.md")} style="padding:8px 0">
      docs/legacy.md ↗
    </a>
    <div class="v" style="padding:8px 0">
      separate Grok Bot products and compatible legacy target
    </div>
  </div>
  <div class="sec">
    <h2>Sum Grok Bot</h2>
    <p>
      These are the instructions for the Sum Grok Bot.
      <a href="https://x.ai/bot/Gkrq4Eb1atRsRZr_MWp_G">Install it here</a>.
    </p>
    <p>
      <a href={repoBlob("sum/README.md")}>Pack recipe ↗</a>
    </p>
  </div>
  <style>
    .index-cards .t {
      font-family: var(--serif);
      font-size: 22px;
      margin-bottom: 6px;
    }
    .index-cards .d {
      color: var(--body);
      font-size: 12px;
    }
  </style>
</DocsLayout>
