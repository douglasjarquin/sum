---
import DocsLayout from "../../layouts/DocsLayout.astro";
import { sitePath } from "../../lib/site-path.mjs";
import { repoBlob } from "../../lib/links.mjs";
---

<DocsLayout title="Documentation — sum" active="docs">
  <h1>Documentation</h1>
  <p class="lede" style="max-width:640px;margin:0 0 32px">
    Roles and work objects use the dictionary in docs/terminology.md: user,
    coordinator, agent, reviewer, task, brief, question, inbox, result.
    Everything below was moved out of the README.
  </p>
  <div class="cells index-cards">
    <a href={sitePath("install")}>
      <div class="t">Install</div>
      <div class="d">
        Requirements, recommended harnesses, install and launch, first prompt.
      </div>
    </a>
    <a href={sitePath("architecture")}>
      <div class="t">Architecture</div>
      <div class="d">
        Session roles, the no-harness install, what's included, and state and
        communication.
      </div>
    </a>
    <a href={sitePath("verification")}>
      <div class="t">Verification</div>
      <div class="d">
        Evidence publication, the nine gates, and brief revisions.
      </div>
    </a>
    <a href={sitePath("skills")}>
      <div class="t">Skills</div>
      <div class="d">
        The six bundled skills and project-local third-party skills.
      </div>
    </a>
    <a href={sitePath("configuration")}>
      <div class="t">Configuration</div>
      <div class="d">Worker harness, presets, and the capacity schema.</div>
    </a>
    <a href={sitePath("herdr")}>
      <div class="t">Herdr backend</div>
      <div class="d">
        Pane identity, env start and stop, native event delivery, and native
        metadata.
      </div>
    </a>
    <a href={sitePath("update")}>
      <div class="t">Update &amp; rollback</div>
      <div class="d">Update, rollback, refresh, and runtime releases.</div>
    </a>
    <a href={sitePath("remainder-cli")}>
      <div class="t">remainder</div>
      <div class="d">
        Provider selection, output formats, flags, --all, and exit codes.
      </div>
    </a>
  </div>
  <div
    class="kv"
    style="grid-template-columns:auto 1fr;column-gap:16px;font-size:12px;margin-top:32px"
  >
    <a href={repoBlob("docs/repairs.md")} style="padding:8px 0">
      docs/repairs.md ↗
    </a>
    <div class="v" style="padding:8px 0">in-scope and expansion repairs</div>
    <a href={repoBlob("docs/recovery.md")} style="padding:8px 0">
      docs/recovery.md ↗
    </a>
    <div class="v" style="padding:8px 0">
      backup, cleanup after a merge, and limits
    </div>
    <a href={repoBlob("docs/terminology.md")} style="padding:8px 0">
      docs/terminology.md ↗
    </a>
    <div class="v" style="padding:8px 0">
      user, coordinator, agent, reviewer, task, brief, question, inbox, result
    </div>
  </div>
  <style>
    .index-cards .t {
      font-family: var(--serif);
      font-size: 22px;
      margin-bottom: 6px;
    }
    .index-cards .d {
      color: var(--body);
      font-size: 12px;
    }
  </style>
</DocsLayout>
