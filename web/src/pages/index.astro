---
import SiteLayout from "../layouts/SiteLayout.astro";
import { sitePath } from "../lib/site-path.mjs";
---

<SiteLayout title="sum — Many agents. One finished task." foot="home">
  <main>
    <div class="hero">
      <div class="main">
        <h1 class="display">Many agents.<br /><em>One finished task.</em></h1>
        <p class="lede">
          Dispatch approved work to isolated agents. A small Herdr-native
          distro: coordinator, workers, verification. It is for someone who
          already has mise, Git, and an authenticated coding harness. The
          default path is one finished task.
        </p>
        <div class="actions">
          <a class="btn" href={sitePath("install")}>Install</a>
          <a class="btn outline" href={sitePath("architecture")}>How it works</a>
        </div>
      </div>
      <div class="rail">
        <div>
          <div class="lbl">Coordinator</div>
          Whatever harness you launch here. Codex, Claude, Grok, cursor-agent,
          pi, OpenCode, Devin.
        </div>
        <div>
          <div class="lbl">Process owner</div>
          Herdr owns processes and worktrees. No sum daemon, scheduler, or
          database server.
        </div>
        <div>
          <div class="lbl">Records</div>
          A small synchronous helper, <code style="color:var(--accent)">bin/sumctl</code>,
          preserves task records.
        </div>
      </div>
    </div>
    <div class="band">
      <div class="feature">
        <div class="n">01</div>
        <div class="t">A separate worktree per worker</div>
        <p>
          The coordinator prepares a Herdr worktree, launches the selected
          worker, and returns control to you. A worker is explicitly given its
          own role; it does not become another coordinator.
        </p>
      </div>
      <div class="feature">
        <div class="n">02</div>
        <div class="t">Nine delivery gates</div>
        <p style="margin-bottom:14px">
          Recorded on the PR. <a href={sitePath("verification")}>Verification →</a>
        </p>
        <div class="chips">
          <span class="chip">Intent</span>
          <span class="chip">Rebase</span>
          <span class="chip">Review</span>
          <span class="chip">Test</span>
          <span class="chip">Document</span>
          <span class="chip">Lint</span>
          <span class="chip">Push</span>
          <span class="chip">PR</span>
          <span class="chip">CI</span>
        </div>
      </div>
      <div class="feature">
        <div class="n">03</div>
        <div class="t">Evidence on the PR</div>
        <p>
          Before/after evidence publishes on <code>pr reconcile</code> unless
          you turn it off.
        </p>
      </div>
      <div class="feature">
        <div class="n">04</div>
        <div class="t">Six bundled skills</div>
        <p>
          /sum-dispatch, /sum-work, /sum-deliver, /sum-status, /sum-develop, and
          /sum-update with rolling session refresh and code-only rollback.
          <a href={sitePath("skills")}>Skills →</a>
        </p>
      </div>
      <div class="feature">
        <div class="n">05</div>
        <div class="t">Optional Herdr hook and metadata</div>
        <p>
          Native event delivery and sidebar tokens stay off until you enable
          them. <a href={sitePath("herdr")}>Herdr backend →</a>
        </p>
      </div>
      <div class="feature">
        <div class="n">06</div>
        <div class="t">Portable verification</div>
        <p>
          A project-root <code>VERIFY.md</code> and <code>mise run verify</code>
          work in any clone without sum or Herdr.
        </p>
      </div>
    </div>
    <div class="band">
      <div class="split">
        <div class="eyebrow">Quick start</div>
        <div class="codeblock">
          <div>git clone https://github.com/douglasjarquin/sum.git</div>
          <div>herdr</div>
          <div class="c"># In a Herdr pane:</div>
          <div>cd /path/to/sum</div>
          <div>mise trust</div>
          <div>mise run setup</div>
          <div>codex   <span class="c"># or claude, grok, cursor-agent, pi, opencode, devin</span></div>
        </div>
        <p style="margin:18px 0 0;font-size:12px">
          A harness that does not auto-load AGENTS.md needs this first prompt:
          <em class="serif">"Read AGENTS.md in this directory, initialize sum, and act as my coordinator."</em>
        </p>
      </div>
      <div class="split">
        <div class="eyebrow">How it works</div>
        <div class="kv flow" style="grid-template-columns:130px 1fr">
          <div class="k">you</div>
          <div class="v">approved requests and decisions ↓</div>
          <div class="k" style="color:var(--accent)">coordinator</div>
          <div class="v">brief, Herdr worktree, launch ↓</div>
          <div class="k">worker</div>
          <div class="v">questions, report, PR ↑</div>
        </div>
        <p style="margin:18px 0 0;font-size:12px">
          A question is saved before notification. A successful send is
          submitted, not acknowledged. Native idle or done is not task
          completion, and a worker's report is not verified success.
        </p>
      </div>
    </div>
  </main>
</SiteLayout>
